{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "All The Context Content-Free Acceptance Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "receipt_id",
    "gate_id",
    "evidence_kind",
    "status",
    "source_commit",
    "content_free"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "receipt_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
    },
    "gate_id": {
      "type": "string",
      "pattern": "^BETA-[A-Z][0-9]{2}$"
    },
    "evidence_kind": {
      "enum": ["source", "exact_downloaded_artifact", "skipped", "unavailable"]
    },
    "status": {
      "enum": ["pass", "fail", "skipped", "unavailable", "not_run"]
    },
    "source_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "candidate_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "content_free": { "const": true },
    "severity": {
      "type": ["string", "null"],
      "enum": ["P0", "P1", "P2", "P3", null]
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "summary"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
          },
          "summary": { "type": "string", "minLength": 1, "maxLength": 500 },
          "severity": { "enum": ["P0", "P1", "P2", "P3"] },
          "workaround": { "type": "string", "maxLength": 500 },
          "follow_up": { "type": "string", "maxLength": 200 }
        }
      }
    },
    "attempts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["attempt", "status"],
        "properties": {
          "attempt": { "type": "integer", "minimum": 1 },
          "status": {
            "enum": ["pass", "fail", "skipped", "unavailable", "not_run"]
          },
          "closed_reason": { "type": "string", "maxLength": 200 }
        }
      }
    },
    "artifact_digests": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,199}$"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "counts": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]{0,63}$"
      },
      "additionalProperties": {
        "type": "integer"
      }
    },
    "notes": {
      "type": "string",
      "maxLength": 280
    },
    "microsoft_reassessment": {
      "$ref": "#/$defs/microsoftReassessment"
    },
    "windows_acceptance": {
      "$ref": "#/$defs/windowsAcceptance"
    }
  },
  "$defs": {
    "windowsAcceptanceDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "sha256", "size"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,199}$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "size": { "type": "integer", "minimum": 1 }
      }
    },
    "windowsAcceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "platform",
        "architecture",
        "source_commit",
        "version",
        "clean_machine",
        "developer_tooling",
        "prerequisites",
        "permissions",
        "defender",
        "core",
        "artifacts",
        "components",
        "checks",
        "leftovers"
      ],
      "properties": {
        "schema_version": { "const": 1 },
        "platform": { "const": "windows" },
        "architecture": { "const": "x86_64" },
        "source_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-beta\\.[1-9][0-9]*)?$"
        },
        "clean_machine": { "const": true },
        "developer_tooling": { "const": false },
        "prerequisites": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "os_family", "architecture", "developer_tooling_absent"],
          "properties": {
            "status": { "enum": ["pass", "fail", "not_run", "unavailable"] },
            "os_family": { "const": "windows" },
            "architecture": { "const": "x86_64" },
            "developer_tooling_absent": { "const": true }
          }
        },
        "permissions": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "scope", "elevation"],
          "properties": {
            "status": { "enum": ["pass", "fail", "not_run", "unavailable"] },
            "scope": { "const": "current_user" },
            "elevation": { "const": "not_required" }
          }
        },
        "defender": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "artifact_scan",
            "real_time_protection_enabled",
            "target_files_present",
            "new_detections",
            "quarantine_events",
            "signature_version"
          ],
          "properties": {
            "status": { "enum": ["pass", "fail", "not_run", "unavailable"] },
            "artifact_scan": { "const": "completed" },
            "real_time_protection_enabled": { "const": true },
            "target_files_present": { "const": true },
            "new_detections": { "type": "integer", "minimum": 0 },
            "quarantine_events": { "type": "integer", "minimum": 0 },
            "signature_version": { "type": "string", "minLength": 1 }
          }
        },
        "core": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "host", "loopback_only", "public_listener_count"],
          "properties": {
            "status": { "enum": ["pass", "fail", "not_run", "unavailable"] },
            "host": { "const": "127.0.0.1" },
            "loopback_only": { "const": true },
            "public_listener_count": { "const": 0 }
          }
        },
        "artifacts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "direct_package",
            "installed_component_archive",
            "installed_component_manifest",
            "installed_component_checksum",
            "native_build_provenance",
            "native_build_provenance_checksum"
          ],
          "properties": {
            "direct_package": { "$ref": "#/$defs/windowsAcceptanceDescriptor" },
            "installed_component_archive": { "$ref": "#/$defs/windowsAcceptanceDescriptor" },
            "installed_component_manifest": { "$ref": "#/$defs/windowsAcceptanceDescriptor" },
            "installed_component_checksum": { "$ref": "#/$defs/windowsAcceptanceDescriptor" },
            "native_build_provenance": { "$ref": "#/$defs/windowsAcceptanceDescriptor" },
            "native_build_provenance_checksum": { "$ref": "#/$defs/windowsAcceptanceDescriptor" }
          }
        },
        "components": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["role", "filename", "sha256", "size"],
            "properties": {
              "role": { "enum": ["main", "mcp", "recovery", "updater"] },
              "filename": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,199}$"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "size": { "type": "integer", "minimum": 1 }
            }
          }
        },
        "checks": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ordinary_install",
            "first_run_setup",
            "restart",
            "login_startup",
            "update_interruption",
            "update_recovery",
            "rollback",
            "uninstall",
            "state_preserved",
            "state_removed",
            "no_leftover_binaries",
            "no_leftover_shortcuts",
            "no_leftover_tasks",
            "no_leftover_runonce",
            "protected_os_store",
            "setup_rollback"
          ],
          "properties": {
            "ordinary_install": { "enum": ["pass", "fail", "not_run", "unavailable"] },
            "first_run_setup": { "enum": ["pass", "fail", "not_run", "unavailable"] },
            "restart": { "enum": ["pass", "fail", "not_run", "unavailable"] },
            "login_startup": { "enum": ["pass", "fail", "not_run", "unavailable"] },
            "update_interruption": { "enum": ["pass", "fail", "not_run", "unavailable"] },
            "update_recovery": { "enum": ["pass", "fail", "not_run", "unavailable"] },
            "rollback": { "enum": ["pass", "fail", "not_run", "unavailable"] },
            "uninstall": { "enum": ["pass", "fail", "not_run", "unavailable"] },
            "state_preserved": { "enum": ["pass", "fail", "not_run", "unavailable"] },
            "state_removed": { "enum": ["pass", "fail", "not_run", "unavailable"] },
            "no_leftover_binaries": { "enum": ["pass", "fail", "not_run", "unavailable"] },
            "no_leftover_shortcuts": { "enum": ["pass", "fail", "not_run", "unavailable"] },
            "no_leftover_tasks": { "enum": ["pass", "fail", "not_run", "unavailable"] },
            "no_leftover_runonce": { "enum": ["pass", "fail", "not_run", "unavailable"] },
            "protected_os_store": { "enum": ["pass", "fail", "not_run", "unavailable"] },
            "setup_rollback": { "enum": ["pass", "fail", "not_run", "unavailable"] }
          }
        },
        "leftovers": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "installed_binaries",
            "shortcuts",
            "scheduled_tasks",
            "runonce_entries",
            "orphaned_client_secrets"
          ],
          "properties": {
            "installed_binaries": { "type": "integer", "minimum": 0 },
            "shortcuts": { "type": "integer", "minimum": 0 },
            "scheduled_tasks": { "type": "integer", "minimum": 0 },
            "runonce_entries": { "type": "integer", "minimum": 0 },
            "orphaned_client_secrets": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "microsoftReassessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_version",
        "source_commit",
        "candidate_sha256",
        "component_role",
        "component_sha256",
        "component_size",
        "installed_component_manifest_sha256",
        "opaque_submission_id_present",
        "microsoft_status",
        "final_determination",
        "determined_at",
        "redacted_result_artifact_sha256"
      ],
      "properties": {
        "candidate_version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-beta\\.[1-9][0-9]*)?$"
        },
        "source_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "candidate_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "component_role": {
          "enum": ["main", "mcp", "recovery", "updater"]
        },
        "component_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "component_size": {
          "type": "integer",
          "minimum": 1
        },
        "installed_component_manifest_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "opaque_submission_id_present": {
          "type": "boolean"
        },
        "microsoft_status": {
          "enum": ["submitted", "in_review", "closed"]
        },
        "final_determination": {
          "enum": ["pending", "no_malware", "malware", "inconclusive"]
        },
        "determined_at": {
          "type": ["string", "null"],
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$"
        },
        "redacted_result_artifact_sha256": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "final_determination": { "const": "pending" }
            }
          },
          "then": {
            "properties": {
              "determined_at": { "const": null },
              "redacted_result_artifact_sha256": { "const": null }
            }
          },
          "else": {
            "properties": {
              "microsoft_status": { "const": "closed" },
              "determined_at": { "type": "string" },
              "redacted_result_artifact_sha256": { "type": "string" }
            }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "required": ["microsoft_reassessment"]
      },
      "then": {
        "properties": {
          "gate_id": { "const": "BETA-S06" }
        }
      }
    },
    {
      "if": {
        "required": ["windows_acceptance"]
      },
      "then": {
        "properties": {
          "gate_id": { "enum": ["BETA-P01", "BETA-S03"] },
          "evidence_kind": { "const": "exact_downloaded_artifact" }
        }
      }
    },
    {
      "if": {
        "properties": {
          "gate_id": { "enum": ["BETA-P01", "BETA-S03"] },
          "status": { "const": "pass" }
        },
        "required": ["gate_id", "status"]
      },
      "then": {
        "required": ["windows_acceptance"],
        "properties": {
          "evidence_kind": { "const": "exact_downloaded_artifact" }
        }
      }
    }
  ]
}
