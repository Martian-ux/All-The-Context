{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "All The Context Acceptance Receipt Bundle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_commit",
    "candidate_sha256",
    "receipts",
    "maintainer_decision"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "source_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "candidate_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-beta\\.[1-9][0-9]*)?$",
      "description": "Candidate version. The runtime validator preserves omitted/through-beta.6 legacy interpretation and requires candidate-bound Microsoft reassessment evidence for a beta.7-or-later BETA-S06 pass."
    },
    "receipts": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "acceptance-receipt.schema.json" }
    },
    "maintainer_decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "independent_human_review_claimed"],
      "properties": {
        "decision": {
          "type": ["string", "null"],
          "enum": ["approve", "reject", null]
        },
        "approver": { "type": "string", "maxLength": 200 },
        "decided_at": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}(T[0-9:.+-Z]+)?$"
        },
        "independent_human_review_claimed": { "const": false },
        "ai_assisted": { "type": "boolean" },
        "notes": { "type": "string", "maxLength": 500 },
        "reviewed_receipt_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "version": {
            "pattern": "^(?:0\\.1\\.0-beta\\.(?:[7-9]|[1-9][0-9]+)|0\\.1\\.0|0\\.1\\.[1-9][0-9]*(?:-beta\\.[1-9][0-9]*)?|0\\.(?:[2-9]|[1-9][0-9]+)\\.(?:0|[1-9][0-9]*)(?:-beta\\.[1-9][0-9]*)?|[1-9][0-9]*\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-beta\\.[1-9][0-9]*)?)$"
          }
        },
        "required": ["version"]
      },
      "then": {
        "properties": {
          "receipts": {
            "items": {
              "if": {
                "properties": {
                  "gate_id": { "const": "BETA-S06" },
                  "status": { "const": "pass" }
                },
                "required": ["gate_id", "status"]
              },
              "then": {
                "required": ["microsoft_reassessment"],
                "properties": {
                  "microsoft_reassessment": {
                    "properties": {
                      "component_role": { "const": "mcp" },
                      "opaque_submission_id_present": { "const": true },
                      "microsoft_status": { "const": "closed" },
                      "final_determination": { "const": "no_malware" },
                      "determined_at": { "type": "string" },
                      "redacted_result_artifact_sha256": { "type": "string" }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "receipts": {
            "items": {
              "not": {
                "required": ["microsoft_reassessment"]
              }
            }
          }
        }
      }
    }
  ]
}
