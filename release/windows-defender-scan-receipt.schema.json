{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "All The Context content-free Windows Defender scan receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "architecture",
    "components",
    "content_free",
    "created_at",
    "defender",
    "history",
    "invocation",
    "manifest",
    "outcome",
    "package",
    "platform",
    "post_scan",
    "receipt_id",
    "receipt_type",
    "reason_codes",
    "schema_version",
    "source_commit",
    "status",
    "version"
  ],
  "properties": {
    "architecture": { "const": "x86_64" },
    "components": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "prefixItems": [
        {
          "allOf": [
            { "$ref": "#/$defs/component" },
            { "properties": { "role": { "const": "main" }, "filename": { "const": "AllTheContext.exe" } } }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/component" },
            { "properties": { "role": { "const": "mcp" }, "filename": { "const": "AllTheContextMCP.exe" } } }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/component" },
            { "properties": { "role": { "const": "recovery" }, "filename": { "const": "AllTheContextRecovery.exe" } } }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/component" },
            { "properties": { "role": { "const": "updater" }, "filename": { "const": "AllTheContextUpdater.exe" } } }
          ]
        }
      ],
      "items": false
    },
    "content_free": { "const": true },
    "created_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$"
    },
    "defender": {
      "anyOf": [
        { "type": "null" },
        { "$ref": "#/$defs/defender" }
      ]
    },
    "history": {
      "anyOf": [
        { "type": "null" },
        { "$ref": "#/$defs/history" }
      ]
    },
    "invocation": { "$ref": "#/$defs/invocation" },
    "manifest": {
      "anyOf": [
        { "type": "null" },
        { "$ref": "#/$defs/manifest" }
      ]
    },
    "outcome": { "enum": ["clean", "detection", "inconclusive"] },
    "package": { "$ref": "#/$defs/file" },
    "platform": { "const": "windows" },
    "post_scan": { "$ref": "#/$defs/postScan" },
    "receipt_id": { "type": "string", "pattern": "^wd-[0-9a-f]{32}$" },
    "receipt_type": { "const": "windows-defender-scan" },
    "reason_codes": {
      "type": "array",
      "items": {
        "enum": [
          "unsupported_platform",
          "defender_unavailable",
          "defender_malformed",
          "defender_disabled",
          "signature_stale",
          "signature_clock_invalid",
          "history_unavailable",
          "history_malformed",
          "scan_timeout",
          "scan_failed",
          "history_detected_before_scan",
          "defender_detection_history",
          "history_changed_during_scan",
          "target_missing_after_scan",
          "target_changed_after_scan",
          "target_reparse_after_scan",
          "defender_status_changed",
          "post_scan_unavailable"
        ]
      }
    },
    "schema_version": { "const": 1 },
    "source_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "status": { "enum": ["pass", "fail", "unavailable", "not_run"] },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-beta\\.[1-9][0-9]*)?$"
    }
  },
  "$defs": {
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["filename", "sha256", "size"],
      "properties": {
        "filename": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,199}\\.exe$"
        },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "size": { "type": "integer", "exclusiveMinimum": 0 }
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "filename", "sha256", "size"],
      "properties": {
        "role": { "enum": ["main", "mcp", "recovery", "updater"] },
        "filename": {
          "enum": [
            "AllTheContext.exe",
            "AllTheContextMCP.exe",
            "AllTheContextRecovery.exe",
            "AllTheContextUpdater.exe"
          ]
        },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "size": { "type": "integer", "exclusiveMinimum": 0 }
      }
    },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["filename", "sha256", "size"],
      "properties": {
        "filename": { "const": "installed-component-manifest-v1.json" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "size": { "type": "integer", "exclusiveMinimum": 0 }
      }
    },
    "defenderSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "engine_version",
        "platform_version",
        "service_version",
        "signature_version",
        "signature_updated_at",
        "signature_age_seconds",
        "antivirus_enabled",
        "real_time_protection_enabled",
        "ioav_protection_enabled",
        "running_mode",
        "readiness"
      ],
      "properties": {
        "engine_version": { "type": "string", "pattern": "^[0-9]+(?:\\.[0-9]+){1,5}$" },
        "platform_version": { "type": "string", "pattern": "^[0-9]+(?:\\.[0-9]+){1,5}$" },
        "service_version": { "type": "string", "pattern": "^[0-9]+(?:\\.[0-9]+){1,5}$" },
        "signature_version": { "type": "string", "pattern": "^[0-9]+(?:\\.[0-9]+){1,5}$" },
        "signature_updated_at": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$"
        },
        "signature_age_seconds": { "type": "integer", "minimum": 0 },
        "antivirus_enabled": { "type": "boolean" },
        "real_time_protection_enabled": { "type": "boolean" },
        "ioav_protection_enabled": { "type": "boolean" },
        "running_mode": { "type": "string", "minLength": 1, "maxLength": 32 },
        "readiness": { "enum": ["ready", "disabled", "stale"] }
      }
    },
    "defender": {
      "type": "object",
      "additionalProperties": false,
      "required": ["before", "after", "stable", "status"],
      "properties": {
        "before": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/defenderSnapshot" }] },
        "after": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/defenderSnapshot" }] },
        "stable": { "type": "boolean" },
        "status": {
          "enum": ["ready", "disabled", "stale", "malformed", "unavailable", "changed"]
        }
      }
    },
    "history": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "before_entry_count",
        "after_entry_count",
        "new_entry_count",
        "preexisting_target_detection_count",
        "target_detection_count",
        "quarantine_or_deletion_detection_count",
        "status",
        "target_count"
      ],
      "properties": {
        "before_entry_count": { "type": "integer", "minimum": 0 },
        "after_entry_count": { "type": "integer", "minimum": 0 },
        "new_entry_count": { "type": "integer", "minimum": 0 },
        "preexisting_target_detection_count": { "type": "integer", "minimum": 0 },
        "target_detection_count": { "type": "integer", "minimum": 0 },
        "quarantine_or_deletion_detection_count": { "type": "integer", "minimum": 0 },
        "status": { "enum": ["clear", "detected"] },
        "target_count": { "const": 5 }
      }
    },
    "invocation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["completed", "result", "scan_type", "settings_changed", "target_count", "tool"],
      "properties": {
        "completed": { "type": "boolean" },
        "result": { "enum": ["not_run", "success", "nonzero", "incomplete"] },
        "scan_type": { "const": "custom" },
        "settings_changed": { "const": false },
        "target_count": { "const": 5 },
        "tool": { "const": "MpCmdRun.exe" }
      }
    },
    "postScan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["presence", "rehashed", "stable", "target_count"],
      "properties": {
        "presence": {
          "enum": ["all_present", "missing", "changed", "reparse", "unavailable", "not_run"]
        },
        "rehashed": { "type": "boolean" },
        "stable": { "type": "boolean" },
        "target_count": { "const": 5 }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "pass" } } },
      "then": {
        "properties": {
          "outcome": { "const": "clean" },
          "reason_codes": { "maxItems": 0 },
          "invocation": {
            "properties": {
              "completed": { "const": true },
              "result": { "const": "success" }
            }
          },
          "post_scan": {
            "properties": {
              "presence": { "const": "all_present" },
              "rehashed": { "const": true },
              "stable": { "const": true }
            }
          },
          "history": {
            "type": "object",
            "properties": {
              "status": { "const": "clear" },
              "new_entry_count": { "const": 0 },
              "target_detection_count": { "const": 0 }
            }
          },
          "defender": {
            "type": "object",
            "properties": {
              "stable": { "const": true },
              "status": { "const": "ready" }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "outcome": { "const": "clean" } } },
      "then": { "properties": { "status": { "const": "pass" } } }
    }
  ]
}
