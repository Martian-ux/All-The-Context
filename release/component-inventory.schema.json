{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "All The Context Component Inventory",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "version",
    "source_commit",
    "project_version",
    "locks",
    "component_count",
    "components"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-beta\\.[1-9][0-9]*)?$"
    },
    "source_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "project_version": { "type": "string", "minLength": 1 },
    "locks": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sha256"],
        "properties": {
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "component_count": { "type": "integer", "minimum": 1 },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ecosystem",
          "name",
          "version",
          "license",
          "locked",
          "source_kind"
        ],
        "properties": {
          "ecosystem": { "enum": ["python", "npm"] },
          "name": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "minLength": 1 },
          "license": { "type": "string", "minLength": 1 },
          "locked": { "const": true },
          "source_kind": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
